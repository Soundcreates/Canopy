# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/canopy_db

# Blockchain Configuration
RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY
ETH_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY

# Governance Contract
GOVERNANCE_CONTRACT_ADDRESS=0x3F4e90564c20Fbbb32E58eFF55Dd4ccBB930fe3b
GOVERNANCE_ORACLE_PRIVATE_KEY=your_oracle_private_key_here
GOVERNANCE_START_BLOCK=0
GOVERNANCE_POLL_INTERVAL_MS=30000

# Token Contract
CTK_TOKEN_ADDRESS=0x99618bccaE46b716E6a77a2E9eea818A7A0d9B9F
TOKEN_ORACLE_PRIVATE_KEY=your_token_oracle_private_key_here

# Server Configuration
MODE=development
FRONTEND_URL_DEF=http://localhost:5173
FRONTEND_URL_PROD=https://canopy-ai.vercel.app

# Enable Governance Indexer
ENABLE_GOVERNANCE_INDEXER=true
